     if (status != 200) {
         syslog(LOG_ERR, "[%s] API error %d: %.500s\n", TAG, status,
             rb.data ? rb.data : "");
+        /* SiliconLoop: park the rejected body so the exact offending
+         * object can be inspected (API 400s on 11-03 needed this).
+         * Dump BEFORE req_release: post_data points into the shared
+         * static buffer and must not be read after ownership ends. */
+        FILE* dump = fopen(AGENT_DATA_DIR "/evidence/last_request.json", "w");
+        if (dump) {
+            fputs(post_data, dump);
+            fclose(dump);
+        }
+    }
+    req_release(post_data, post_is_static);
+
