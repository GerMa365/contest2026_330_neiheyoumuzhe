diff --git a/src/llm/llm_proxy.c b/src/llm/llm_proxy.c
--- a/src/llm/llm_proxy.c
+++ b/src/llm/llm_proxy.c
@@ -64,8 +64,74 @@
  * window; llm calls funnel through the single agent loop task so it is
  * uncontended in practice. Every req_serialize() pairs with exactly one
  * req_release(). */
+/* TESTABLE: alloc-guard begin */
+/* SiliconLoop (2026-11-03 hypothesis): cJSON swallows allocation
+ * failures — cJSON_AddStringToObject/cJSON_Duplicate just don't add the
+ * field when malloc returns NULL, so a starved heap silently produces a
+ * request tree with missing fields (the 400 "name/function is not set"
+ * class). Count failures per request to test this. */
+static unsigned s_alloc_fail;
+static unsigned s_alloc_fail_logged;
+
+static void* counting_malloc(size_t sz)
+{
+    void* p = malloc(sz);
+    if (!p) {
+        s_alloc_fail++;
+    }
+    return p;
+}
+
+static void counting_free(void* p)
+{
+    free(p);
+}
+
+unsigned llm_alloc_fail_count(void)
+{
+    return s_alloc_fail;
+}
+
+static void install_alloc_hooks(void)
+{
+    static cJSON_Hooks hooks;
+    hooks.malloc_fn = counting_malloc;
+    hooks.free_fn = counting_free;
+    cJSON_InitHooks(&hooks);
+}
+
+/* Pre-send sanity: a request tree missing tool names or message roles
+ * must never reach the wire (kept regardless of the alloc hypothesis). */
+static int validate_request_tree(cJSON* body)
+{
+    cJSON* tools = cJSON_GetObjectItem(body, "tools");
+    if (tools && cJSON_IsArray(tools)) {
+        cJSON* t;
+        cJSON_ArrayForEach(t, tools) {
+            cJSON* fn = cJSON_GetObjectItem(t, "function");
+            cJSON* nm = fn ? cJSON_GetObjectItem(fn, "name") : NULL;
+            if (!fn || !nm || !cJSON_IsString(nm) || !nm->valuestring[0]) {
+                return ERROR;
+            }
+        }
+    }
+    cJSON* msgs = cJSON_GetObjectItem(body, "messages");
+    if (!msgs || !cJSON_IsArray(msgs) || cJSON_GetArraySize(msgs) == 0) {
+        return ERROR;
+    }
+    cJSON* m;
+    cJSON_ArrayForEach(m, msgs) {
+        cJSON* role = cJSON_GetObjectItem(m, "role");
+        if (!role || !cJSON_IsString(role)) {
+            return ERROR;
+        }
+    }
+    return OK;
+}
+/* TESTABLE: alloc-guard end */
+
 /* TESTABLE: req-buf begin */
-static char s_req_buf[20480];
+static char s_req_buf[16384]; /* 16 KB: max observed request 12.7 KB */
 static pthread_mutex_t s_req_lock = PTHREAD_MUTEX_INITIALIZER;
 
