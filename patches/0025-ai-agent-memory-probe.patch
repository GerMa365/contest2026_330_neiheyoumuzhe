 /* ── HTTP/1.1 framing ────────────────────────────────────────── */
 
+#ifdef CONFIG_SILOOP_MEMPROBE
+/* SiliconLoop: log the peak-path heap watermark right before the
+ * request write.  This is the tightest point of the LLM request:
+ * the body (~12KB) is fully serialized and held in a static buffer,
+ * and the next allocation is the 4KB header block below.  The M4
+ * memory regression surfaces exactly here (write -5 = this malloc
+ * failing).  Uses mallinfo() only — no heap allocation of its own.
+ * Gated by CONFIG_SILOOP_MEMPROBE; see patches/README.md 0025. */
+static void sloop_memprobe_peak(size_t body_len)
+{
+    struct mallinfo mi = mallinfo();
+    syslog(LOG_INFO,
+        "[sloop-memprobe] peak pre-write req=%zu maxfree=%u free=%u\n",
+        body_len, mi.mxordblk, mi.fordblks);
+}
+#define SLOOP_MEMPROBE(body_len) sloop_memprobe_peak(body_len)
+#else
+#define SLOOP_MEMPROBE(body_len) \
+    do {                         \
+    } while (0)
+#endif
+
 static int tls_write_request(tls_ctx_t* ctx,
     const char* method, const char* host,
     const char* path,
     const vela_header_t* headers,
     const char* body, size_t body_len)
 {
