--- /dev/null
+++ b/src/tools/hotfix_exports.c
@@ -0,0 +1,40 @@
+/* SiliconLoop M4: symbol table for the L3 hotfix payload loader.
+ * Recover_task exec's /data/patches/buggy_app_fixed through exec_spawn()
+ * with THIS table - the same pattern as apps/examples/elf (mksymtab),
+ * but a hand-maintained exact-match table instead of a firmware-wide
+ * scan. Contents are the `nm -u` import list of apps/bin/buggy_app_fixed
+ * (symbol audit 2026-11-08, 16 symbols: fclose fopen fprintf fputs
+ * getpid printf pthread_create pthread_mutex_lock pthread_mutex_unlock
+ * puts sched_getparam sched_setparam signal sleep strcmp usleep), so
+ * every import resolves and nothing extra is exposed. Re-run the audit
+ * (nm -u apps/bin/buggy_app_fixed) whenever the payload source changes
+ * and update this table in the same commit. */
+#include "tools/hotfix_exports.h"
+
+#include <stdio.h>
+#include <unistd.h>
+#include <signal.h>
+#include <pthread.h>
+#include <sched.h>
+
+const HOTFIX_SYMTAB g_hotfix_exports[] = {
+	{ "fclose", (void *)fclose },
+	{ "fopen", (void *)fopen },
+	{ "fprintf", (void *)fprintf },
+	{ "fputs", (void *)fputs },
+	{ "getpid", (void *)getpid },
+	{ "printf", (void *)printf },
+	{ "pthread_create", (void *)pthread_create },
+	{ "pthread_mutex_lock", (void *)pthread_mutex_lock },
+	{ "pthread_mutex_unlock", (void *)pthread_mutex_unlock },
+	{ "puts", (void *)puts },
+	{ "sched_getparam", (void *)sched_getparam },
+	{ "sched_setparam", (void *)sched_setparam },
+	{ "signal", (void *)signal },
+	{ "sleep", (void *)sleep },
+	{ "strcmp", (void *)strcmp },
+	{ "usleep", (void *)usleep },
+};
+
+const int g_hotfix_nexports = sizeof(g_hotfix_exports)
+	/ sizeof(g_hotfix_exports[0]);
