@@ -0,0 +1,34 @@
+/* SiliconLoop M4: symbol table for the L3 hotfix payload loader.
+ * recover_task exec's /data/patches/buggy_app_fixed through
+ * exec_spawn() with THIS table - the same pattern as
+ * apps/examples/elf/main/test_symtab.c, extended with the symbols the
+ * fixed build actually imports (see the M4 acceptance symbol audit).
+ * Host tests compile tool_recover.c without nuttx headers; this header
+ * mirrors the minimal symtab type there. */
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifdef SILILOOP_HOST_TEST
+struct hotfix_symtab_s {
+    const char *name;
+    void *addr;
+};
+#define HOTFIX_SYMTAB struct hotfix_symtab_s
+#else
+/* SiliconLoop: sys/types.h pulls in nuttx/compiler.h, which defines FAR -
+ * symtab.h itself relies on the includer having done that (it does not
+ * include compiler.h on its own). */
+#include <sys/types.h>
+#include <nuttx/symtab.h>
+#define HOTFIX_SYMTAB struct symtab_s
+#endif
+
+extern const HOTFIX_SYMTAB g_hotfix_exports[];
+extern const int g_hotfix_nexports;
+
+#ifdef __cplusplus
+}
+#endif
