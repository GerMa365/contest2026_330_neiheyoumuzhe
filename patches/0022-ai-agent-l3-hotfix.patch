+/* Payload sanity before handing the file to the loader: exists, regular,
+ * size within [sizeof(Elf32_Ehdr), HOTFIX_MAX_BYTES]. A truncated or
+ * hostile file must fail HERE, not inside load_module. */
+#ifndef SILILOOP_HOST_TEST
+static int hotfix_payload_ok(const char *path)
+{
+    struct stat st;
+    if (stat(path, &st) != 0 || !S_ISREG(st.st_mode)) {
+        syslog(LOG_WARNING, "[%s] hotfix payload missing: %s\n", TAG, path);
+        return ERROR;
+    }
+    if (st.st_size < 52 || st.st_size > HOTFIX_MAX_BYTES) {
+        syslog(LOG_WARNING, "[%s] hotfix payload size invalid: %ld\n",
+            TAG, (long)st.st_size);
+        return ERROR;
+    }
+    return OK;
+}
+#endif /* !SILILOOP_HOST_TEST */
+
+/* L3: stop the faulty task, exec the fixed ELF as a NEW task (exec_spawn
+ * keeps the agent alive and returns the new pid), and let the fixed
+ * build re-publish its identity files. On spawn failure the payload is
+ * left in place (operator may re-push it) and the ladder escalates.
+ * Host tests have no NuttX exec_spawn (and glibc's spawnattr has no
+ * priority field): compiled out there; L3 coverage is board acceptance. */
+#ifndef SILILOOP_HOST_TEST
+static int rung_hotfix(const char *mode, long *post_delta)
+{
+    pid_t pid;
+    char *argv[3];
+    posix_spawnattr_t attr;
+
+    if (hotfix_payload_ok(HOTFIX_ELF_PATH) != OK) {
+        return ERROR;
+    }
+
+    stop_task();
+
+    /* Same priority/stack as the buggy build's registration (hello_app
+     * Makefile: PRIORITY 50, STACKSIZE 4096) so the fixed task behaves
+     * like the one it replaces. exec_module reads priority/stacksize
+     * directly off the attr (binfmt_exec.c), no flags needed. */
+    posix_spawnattr_init(&attr);
+    attr.priority = 50;
+    attr.stacksize = 4096;
+
+    argv[0] = (char *)"buggy_app_fixed";
+    if (mode && strcmp(mode, "normal") != 0) {
+        argv[1] = (char *)mode;
+        argv[2] = NULL;
+    } else {
+        argv[1] = NULL;
+    }
+
+    pid = exec_spawn(HOTFIX_ELF_PATH, argv, NULL,
+        g_hotfix_exports, g_hotfix_nexports, NULL, &attr);
+    posix_spawnattr_destroy(&attr);
+    if (pid < 0) {
+        syslog(LOG_ERR, "[%s] exec_spawn(%s) failed: %d\n",
+            TAG, HOTFIX_ELF_PATH, errno);
+        return ERROR;
+    }
+    syslog(LOG_INFO, "[%s] hotfix task started pid=%d\n", TAG, (int)pid);
+
+    usleep(6000000);
+    return measure_delta(post_delta);
+}
+#endif /* !SILILOOP_HOST_TEST */
+
