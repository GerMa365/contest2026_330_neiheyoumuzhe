+/* ── L3 hotfix (M4) ─────────────────────────────────────────────── */
+
+/* Payload location. /data is tmpfs on this board: the payload is pushed
+ * per-session by the operator (fwpush) and does not survive reboot;
+ * Flash persistence is a post-defense roadmap item (SmartFS). */
+#define HOTFIX_ELF_PATH AGENT_DATA_DIR "/patches/buggy_app_fixed"
+/* Refuse absurd payloads early; the real one is ~5 KB. */
+#define HOTFIX_MAX_BYTES (16 * 1024)
+
+/* SiliconLoop: exec_spawn() is NuttX binfmt's caller-provided-symbol-table
+ * loader that starts a NEW task and returns (binfmt.h: exec_spawn).
+ * posix_spawn() is not an option here: CONFIG_EXECFUNCS_HAVE_SYMTAB is
+ * off, so the OS-side symbol table posix_spawn relies on does not exist
+ * and the relocatable ELF could not be linked. exec() (the image-swap
+ * variant used by the elf example) would replace the agent's own image. */
+#ifndef SILILOOP_HOST_TEST
+#include <nuttx/binfmt/binfmt.h>
+#endif
