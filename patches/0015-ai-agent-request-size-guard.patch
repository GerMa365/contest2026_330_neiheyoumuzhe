+                "- **%s**: %s (read with: read_file %s)\n",
+                title, desc, full_path);
+        }
+        /* SiliconLoop: snprintf returns the *would-be* length, so a long
+         * line can push `off` past `size`; the trailing buf[off] write
+         * would then go out of bounds (summary lives in a 1 KB stack
+         * buffer in the system-prompt path). Clamp instead. */
+        if (line_len < 0) {
+            break;
+        }
+        if ((size_t)line_len >= size - off) {
+            off = size - 1;
+            break;
+        }
+        off += (size_t)line_len;
     }
 
