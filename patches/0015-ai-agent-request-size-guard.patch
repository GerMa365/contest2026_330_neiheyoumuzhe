@@ -121,6 +121,77 @@
 static agent_mem_pool_t s_tool_pool;
 static bool s_pool_ready = false;
 
+/* TESTABLE: mem-guard begin */
+#define TOOL_MSG_MAX (1536)
+#define REASONING_ECHO_MAX (256)
+
+/* SiliconLoop: cut s at a UTF-8 character boundary. Byte-precision
+ * truncation (snprintf "%.<n>s") lands mid-character on CJK text and a
+ * partial sequence inside a JSON string makes the API reject the whole
+ * request ("Invalid JSON in request body", m1-b6c-validate.r2 — the
+ * thinking echo is Chinese and was being cut at byte 256). */
+static void utf8_cut(char* s, size_t max)
+{
+    if (strlen(s) <= max) {
+        return;
+    }
+    s[max] = '\0';
+    size_t i = max;
+    /* back over continuation bytes to the lead of the char at the cut */
+    while (i > 0 && ((unsigned char)s[i - 1] & 0xC0) == 0x80) {
+        i--;
+    }
+    if (i > 0) {
+        unsigned char lead = (unsigned char)s[i - 1];
+        size_t need = 1;
+        if ((lead & 0xE0) == 0xC0) need = 2;
+        else if ((lead & 0xF0) == 0xE0) need = 3;
+        else if ((lead & 0xF8) == 0xF0) need = 4;
+        if (i - 1 + need > max) {
+            i--; /* multibyte char split by the cut: drop the partial one */
+        }
+    }
+    s[i] = '\0';
+}
+
+static const char* cap_tool_content(const char* content)
+{
+    /* +64, not +32: the truncation marker is 44 B and the old buffer
+     * overflowed 12 B past the static (m1-b6-validate.r2 showed a
+     * corrupted tool message reaching the API). */
+    static char capped[TOOL_MSG_MAX + 64];
+    size_t len = strlen(content);
+    if (len <= TOOL_MSG_MAX) {
+        return content;
+    }
+    /* snprintf with explicit bound + UTF-8-safe cut + marker appended
+     * with the remaining size — no strcat anywhere. */
+    snprintf(capped, TOOL_MSG_MAX + 1, "%s", content);
+    utf8_cut(capped, TOOL_MSG_MAX);
+    size_t used = strlen(capped);
+    snprintf(capped + used, sizeof(capped) - used,
+        "\n[...truncated by SiliconLoop memory guard]");
+    syslog(LOG_INFO, "[agent] Tool result capped: %d -> %d bytes\n",
+        (int)len, (int)strlen(capped));
+    return capped;
+}
+
+static const char* cap_reasoning_content(const char* content)
+{
+    static char reasoning_capped[REASONING_ECHO_MAX + 64];
+    size_t len = strlen(content);
+    if (len <= REASONING_ECHO_MAX) {
+        return content;
+    }
+    snprintf(reasoning_capped, REASONING_ECHO_MAX + 1, "%s", content);
+    utf8_cut(reasoning_capped, REASONING_ECHO_MAX);
+    size_t used = strlen(reasoning_capped);
+    snprintf(reasoning_capped + used, sizeof(reasoning_capped) - used,
+        "\n[...thinking truncated by SiliconLoop memory guard]");
+    return reasoning_capped;
+}
+/* TESTABLE: mem-guard end */
