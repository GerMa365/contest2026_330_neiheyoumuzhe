+/* SiliconLoop: cap tool-result content stored in the LLM request.
+ * Full outputs (ps, read_file of skills) can be several KB each; over 7
+ * iterations they dominate the request body and caused step-7 serialization
+ * OOM (see docs/closed-loop-plan.md). The model only needs the head of each
+ * result to reason, so keep the first TOOL_MSG_MAX bytes and mark the cut. */
+#define TOOL_MSG_MAX (1536)
+
+static const char* cap_tool_content(const char* content)
+{
+    static char capped[TOOL_MSG_MAX + 32];
+    size_t len = strlen(content);
+    if (len <= TOOL_MSG_MAX) {
+        return content;
+    }
+    memcpy(capped, content, TOOL_MSG_MAX);
+    capped[TOOL_MSG_MAX] = '\0';
+    strcat(capped, "\n[...truncated by SiliconLoop memory guard]");
+    syslog(LOG_INFO, "[agent] Tool result capped: %d -> %d bytes\n",
+        (int)len, (int)strlen(capped));
+    return capped;
+}
+
 /* Add one role:"tool" message per tool result (OpenAI format).
  * When call_count > 1, all tools run in parallel threads.
  * Uses memory pool for parallel buffers, with heap fallback. */
@@ -240,7 +278,8 @@
