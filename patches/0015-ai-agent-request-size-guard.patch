diff --git a/src/tools/skill_loader.c b/src/tools/skill_loader.c
--- a/src/tools/skill_loader.c
+++ b/src/tools/skill_loader.c
@@ -410,10 +410,48 @@
         extract_description(f, desc, sizeof(desc));
         fclose(f);
 
-        /* Append to summary */
-        off += snprintf(buf + off, size - off,
-            "- **%s**: %s (read with: read_file %s)\n",
-            title, desc, full_path);
+        /* SiliconLoop: the heartbeat diagnostic runs every 2 minutes; having
+         * the LLM read_file the full skill each round cost ~2 KB of request
+         * body (file + JSON escaping) and pushed step-7 requests toward the
+         * 12.5 KB serialization-OOM zone. The skill is firmware-constant, so
+         * inline its steps in the summary and drop the per-round read. The
+         * "(read with: ...)" hint is suppressed for it, or the model would
+         * follow the hint and read the file anyway. */
+        /* SiliconLoop: clamp the running offset to what actually fits.
+         * snprintf returns the *would-be* length; without this, one long
+         * line can push `off` past `size` and the final buf[off] write
+         * out of bounds (the summary sits in a 1 KB stack buffer in the
+         * system-prompt path). */
+        int line_len;
+        if (strcmp(name, "self-diagnostic.md") == 0) {
+            line_len = snprintf(buf + off, size - off,
+                "- **%s**: %s (steps inline — do NOT read the skill file)\n"
+                "  1) read_file %s/evidence/heartbeat.txt; "
+                "2) run_shell \"ps\"; 3) run_shell \"free\"; "
+                "4) read_file heartbeat.txt again; "
+                "5) write_file the report to "
+                "%s/evidence/report.md with sections "
+                "**Observed Evidence**, **Hypothesis**, **Confidence**, "
+                "**Proposed Test or Fix**. Judge by heartbeat delta: "
+                "increased=healthy, identical=stall.\n",
+                title, desc, AGENT_DATA_DIR, AGENT_DATA_DIR);
+        } else {
+            line_len = snprintf(buf + off, size - off,
+                "- **%s**: %s (read with: read_file %s)\n",
+                title, desc, full_path);
+        }
+        /* SiliconLoop: snprintf returns the *would-be* length, so a long
+         * line can push `off` past `size`; the trailing buf[off] write
+         * would then go out of bounds (summary lives in a 1 KB stack
+         * buffer in the system-prompt path). Clamp instead. */
+        if (line_len < 0) {
+            break;
+        }
+        if ((size_t)line_len >= size - off) {
+            off = size - 1;
+            break;
+        }
+        off += (size_t)line_len;
     }
 
     closedir(dir);
