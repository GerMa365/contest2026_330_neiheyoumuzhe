diff --git a/src/llm/llm_proxy.c b/src/llm/llm_proxy.c
--- a/src/llm/llm_proxy.c
+++ b/src/llm/llm_proxy.c
@@ -53,6 +53,44 @@
 
 static pthread_mutex_t s_llm_lock = PTHREAD_MUTEX_INITIALIZER;
 
+/* SiliconLoop: request bodies reach ~12 KB at step 7 of the heartbeat
+ * diagnostic. cJSON_PrintUnformatted grows its output buffer by doubling,
+ * so the transient contiguous need is up to ~2x the body — on a heap
+ * fragmented by the tool pool + TLS buffers that alloc failed exactly at
+ * step 7 ("OOM: failed to serialize request body", the 9-16 regression's
+ * failure mode and m1-50round.r4/r7). Serialize into this static buffer
+ * instead: zero heap churn, sized past the worst request seen (12.7 KB)
+ * with margin. The lock serializes the whole serialize-send-release
+ * window; llm calls funnel through the single agent loop task so it is
+ * uncontended in practice. Every req_serialize() pairs with exactly one
+ * req_release(). */
+/* TESTABLE: req-buf begin */
+static char s_req_buf[20480];
+static pthread_mutex_t s_req_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static char* req_serialize(cJSON* body, bool* is_static)
+{
+    pthread_mutex_lock(&s_req_lock);
+    if (cJSON_PrintPreallocated(body, s_req_buf, (int)sizeof(s_req_buf), 0)) {
+        *is_static = true;
+        return s_req_buf;
+    }
+    syslog(LOG_WARNING,
+        "[%s] request exceeds %d B static buffer, heap fallback\n",
+        TAG, (int)sizeof(s_req_buf));
+    *is_static = false;
+    return cJSON_PrintUnformatted(body);
+}
+
+static void req_release(char* post_data, bool is_static)
+{
+    if (post_data && !is_static) {
+        free(post_data);
+    }
+    pthread_mutex_unlock(&s_req_lock);
+}
+/* TESTABLE: req-buf end */
