         }
 
@@ -1647,6 +1655,9 @@
 
         syslog(LOG_INFO, "[%s] Processing message from %s:%s\n",
             TAG, msg.channel, msg.chat_id);
+        /* SiliconLoop: per-message boundary for the fallback report -
